{
  "manifest_version": 3,
  "name": "Youtube Ad-Free Video",
  "version": "1.0.0",
  "description": "Open YouTube videos on the ad-free video redirect page.",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://*.youtube.com/*"
  ],
  "icons": {
    "16": "youtube-ad-free-video.png",
    "48": "youtube-ad-free-video.png",
    "128": "youtube-ad-free-video.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_icon": {
      "16": "youtube-ad-free-video.png",
      "48": "youtube-ad-free-video.png",
      "128": "youtube-ad-free-video.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
